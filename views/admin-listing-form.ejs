<% var active='listings'; var pageTitle=listing?'Edit Property':'Add Property'; %><%- include('partials/admin-header') %><div class="admin-form-wrap"><h2><%= listing?'Edit Property':'Add New Property' %></h2><p class="muted">Complete details help customers compare and enquire.</p><form method="post" action="/admin/listings/save" enctype="multipart/form-data"><%if(listing){%><input type="hidden" name="id" value="<%=listing.id%>"><%}%><div class="form-grid"><% const dbKey={carpetArea:'carpet_area',mapUrl:'map_url',brochureUrl:'brochure_url'};const fs=[['title','Project title'],['builder','Builder'],['location','Location'],['bhk','Configuration'],['possession','Possession'],['rera','RERA number'],['area','Super built-up area'],['carpetArea','Carpet area'],['mapUrl','Google Maps link'],['brochureUrl','Brochure PDF link']];fs.forEach(f=>{%><div class="form-field"><label><%=f[1]%></label><input name="<%=f[0]%>" value="<%=listing?.[dbKey[f[0]]||f[0]]||''%>"></div><%})%><div class="form-field"><label>Property type</label><select name="propertyType"><%['','Apartment','Villa','Plot','Commercial'].forEach(x=>{%><option value="<%=x%>" <%=listing?.property_type===x?'selected':''%>><%=x||'Select type'%></option><%})%></select></div><div class="form-field"><label>Status</label><select name="status"><option value="available" <%=listing?.status==='available'?'selected':''%>>Available</option><option value="sold" <%=listing?.status==='sold'?'selected':''%>>Sold Out</option></select></div><div class="form-field"><label>Min price ₹</label><input type="text" inputmode="numeric" name="priceMin" value="<%=listing?.price_min||''%>"></div><div class="form-field"><label>Max price ₹</label><input type="text" inputmode="numeric" name="priceMax" value="<%=listing?.price_max||''%>"></div></div><label class="check"><input type="checkbox" name="featured" <%=listing?.featured!==false?'checked':''%>> Featured property</label><%if(listing?.images?.length){%><textarea name="existingImages" style="display:none"><%=listing.images.join("\n")%></textarea><%}%><div class="form-field"><label>Upload property photos</label><input type="file" name="photos" accept="image/*" multiple><small>Select multiple photos directly from your phone or computer.</small></div><div class="form-field"><label>Property images — one URL per line</label><textarea name="images"><%=listing?((listing.images||[]).filter(Boolean).join('\n')):''%></textarea><small>You can add multiple photos. Individual removal below.</small></div><%if(listing?.images?.length){%><div class="thumb-admin"><%listing.images.forEach(img=>{%><div><img src="<%=img%>"><form method="post" action="/admin/listings/<%=listing.id%>/images/remove"><input type="hidden" name="image" value="<%=img%>"><button class="btn btn-danger btn-sm">Remove</button></form></div><%})%></div><%}%><div class="form-field"><label>Amenities (comma separated)</label><input name="amenities" value="<%=listing?.amenities?.join(', ')||''%>"></div><div class="form-field"><label>Floor plan URLs — one per line</label><textarea name="floorPlans"><%=listing?.floor_plans?.join('\n')||''%></textarea></div><div class="form-field"><label>Description</label><textarea name="description"><%=listing?.description||''%></textarea></div><button class="btn btn-primary">Save Property</button> <a href="/admin/listings" class="btn btn-outline">Cancel</a></form></div><%- include('partials/admin-footer') %>
