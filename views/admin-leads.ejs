<% var active='leads'; var pageTitle='Lead CRM'; %><%- include('partials/admin-header') %><h2>Lead CRM</h2><p>Track enquiries, follow-ups and conversion.</p><div class="lead-list"><%leads.forEach(l=>{%><div class="lead-card"><div><h3><%=l.name%></h3><p><a href="tel:<%=l.phone%>"><%=l.phone%></a> · <%=l.email||'No email'%></p><p><strong>Property:</strong> <%=l.property_title||'General enquiry'%></p><p><%=l.message||''%></p></div><form method="post" action="/admin/leads/<%=l.id%>/update"><select name="status"><%['new','contacted','follow-up','site visit','converted','lost'].forEach(s=>{%><option value="<%=s%>" <%=l.status===s?'selected':''%>><%=s%></option><%})%></select><label>Next follow-up</label><input type="date" name="followUpDate" value="<%=l.follow_up_date||''%>"><textarea name="notes" placeholder="Notes"><%=l.notes||''%></textarea><button class="btn btn-primary btn-sm">Save</button></form><form method="post" action="/admin/leads/<%=l.id%>/delete"><button class="btn btn-danger btn-sm">Delete</button></form></div><%})%></div><%- include('partials/admin-footer') %>