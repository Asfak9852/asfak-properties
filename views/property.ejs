<%- include('partials/header') %>
<section class="property-page"><div class="container">
<a href="/listings" class="back-link">← Back to properties</a>
<div class="property-header"><div>
<div class="gallery"><img id="mainImage" src="<%= property.images[0] || '' %>" alt="<%= property.title %>"><button class="gallery-nav prev" onclick="changeImage(-1)">‹</button><button class="gallery-nav next" onclick="changeImage(1)">›</button></div>
<div class="thumbs"><% property.images.forEach((img,i)=>{ %><img src="<%=img%>" onclick="showImage(<%=i%>)" alt="Property image <%=i+1%>"><% }) %></div>
<h1><%= property.title %></h1><p class="property-sub"><%= property.location %> · by <%= property.builder %></p><div class="price-big">₹<%= formatPrice(property.price_min) %> – ₹<%= formatPrice(property.price_max) %></div>
<p><%= property.description %></p>
<h3>Property Overview</h3><ul class="spec-list"><li><span>Configuration</span><span><%=property.bhk%></span></li><% if(property.property_type){%><li><span>Property Type</span><span><%=property.property_type%></span></li><%}%><% if(property.area){%><li><span>Area</span><span><%=property.area%></span></li><%}%><% if(property.carpet_area){%><li><span>Carpet Area</span><span><%=property.carpet_area%></span></li><%}%><li><span>Possession</span><span><%=property.possession%></span></li><li><span>RERA</span><span><%=property.rera%></span></li></ul>
<% if(property.amenities.length){%><h3>Amenities</h3><div class="amenities"><%property.amenities.forEach(a=>{%><span>✓ <%=a%></span><%})%></div><%}%>
<% if(property.floor_plans && property.floor_plans.length){%><h3>Floor Plans</h3><div class='floorplans'><%property.floor_plans.forEach((f,i)=>{%><a href='<%=f%>' target='_blank' class='btn btn-outline'>View Floor Plan <%=i+1%></a><%})%></div><%}%><% if(property.map_url || property.brochure_url){%><div class="resource-links"><%if(property.map_url){%><a class="btn btn-outline" target="_blank" href="<%=property.map_url%>">View Location</a><%}%><%if(property.brochure_url){%><a class="btn btn-outline" target="_blank" href="<%=property.brochure_url%>">Download Brochure</a><%}%></div><%}%>
</div><aside><div class="sidebar-card"><h3>Interested?</h3><p>Get pricing, floor plans and site visit assistance.</p><a href="/contact?property=<%= encodeURIComponent(property.title) %>" class="btn btn-primary btn-block">Request Callback</a><a href="https://wa.me/<%= site.AGENT_WHATSAPP %>?text=<%= encodeURIComponent('Hi, I am interested in ' + property.title) %>" target="_blank" class="btn btn-outline btn-block">WhatsApp Us</a></div></aside></div></div></section>
<script>const imgs=<%- JSON.stringify(property.images) %>;let current=0;function showImage(i){current=i;document.getElementById('mainImage').src=imgs[i]}function changeImage(n){showImage((current+n+imgs.length)%imgs.length)}</script><%- include('partials/footer') %>
